{
  "name": "revomail-frontend-demo",
  "version": "0.1.0",
  "description": "AI-assisted email client and cross-platform desktop launcher",
  "author": "RevoMail Contributors",
  "private": true,
  "type": "module",
  "main": "desktop/main.js",
  "scripts": {
    "setup": "node scripts/setup-python-env.mjs",
    "postinstall": "npm run setup",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "prestart": "npm run setup",
    "start": "node scripts/python-runtime.mjs -m backend.run",
    "test": "npm run test:js && npm run test:python",
    "test:js": "vitest run",
    "pretest:python": "npm run setup",
    "test:python": "node scripts/python-runtime.mjs -m pytest",
    "test:db": "vitest run backend/tests/integration/sqlite-auth.test.js",
    "test:watch": "vitest",
    "db:migrate": "node scripts/python-runtime.mjs -m backend.migrate up",
    "db:migrate:dev": "node scripts/python-runtime.mjs -m backend.migrate up",
    "db:rollback": "node scripts/python-runtime.mjs -m backend.migrate down",
    "pm2:start": "npm run build && pm2 start ecosystem.config.cjs",
    "pm2:logs": "pm2 logs revomail",
    "pm2:restart": "npm run build && pm2 restart revomail",
    "pm2:stop": "pm2 stop revomail",
    "pm2:delete": "pm2 delete revomail",
    "predesktop": "npm run setup",
    "desktop": "npm run build && electron .",
    "predesktop:dev": "npm run setup",
    "desktop:dev": "electron .",
    "prebackend:pack": "npm run setup",
    "backend:pack": "node scripts/build-python-backend.mjs",
    "backend:smoke": "node scripts/smoke-python-backend.mjs",
    "desktop:smoke": "node scripts/smoke-desktop-service.mjs",
    "desktop:ui-smoke": "node scripts/smoke-electron-ui.mjs",
    "desktop:pack": "npm run build && npm run backend:pack && electron-builder --dir",
    "desktop:dist": "npm run build && npm run backend:pack && electron-builder",
    "verify:push": "npm test && npm run build && npm run desktop:pack && npm run desktop:smoke"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "lucide": "^0.468.0",
    "supertest": "^7.2.2",
    "vite": "^6.1.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.revomail.desktop",
    "productName": "RevoMail",
    "asar": true,
    "asarUnpack": [
      "dist/**/*",
      "database/migrations/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "build/python/revomail-backend",
        "to": "python-backend"
      }
    ],
    "files": [
      "desktop/**/*",
      "database/migrations/**/*",
      "dist/**/*",
      "scripts/python-runtime.mjs",
      "package.json",
      "!desktop/tests/**/*"
    ],
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  }
}
