# Runtime
REVOMAIL_ENV=development
HOST=127.0.0.1
PORT=4173
APP_BASE_URL=http://localhost:4173
REVOMAIL_DEBUG=false

# Persistence and server-side security
DATABASE_URL=file:./data/revomail.db
SECRET_KEY=
TOKEN_ENCRYPTION_KEY=
JOB_LEASE_SECONDS=60
JOB_MAX_ATTEMPTS=3

# Google OAuth and Gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4173/api/v1/auth/google/callback

# Microsoft support is reserved and remains pending
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# AI provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
