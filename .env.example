# Runtime
REVOMAIL_ENV=development
HOST=127.0.0.1
PORT=4173
APP_BASE_URL=http://localhost:4173
REVOMAIL_DEBUG=false

# Persistence and server-side security
# SECRET_KEY and TOKEN_ENCRYPTION_KEY are optional. When left empty, RevoMail
# generates both on first startup and stores them in data/revomail-server.key.
DATABASE_URL=file:./data/revomail.db
SECRET_KEY=
TOKEN_ENCRYPTION_KEY=
JOB_LEASE_SECONDS=60
JOB_MAX_ATTEMPTS=3
MAIL_SEND_LIMIT_PER_MINUTE=10

# Google OAuth, Gmail and Calendar (enable Calendar API; reconnect for calendar.events)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4173/api/v1/auth/google/callback

# AI provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Optional additional chat models (JSON array); OPENAI_MODEL is always allowed.
AI_ALLOWED_MODELS=[]
# Speech uses the server-side OPENAI_API_KEY; no audio is persisted by RevoMail.
SPEECH_MODEL=gpt-transcribe
SPEECH_API_URL=https://api.openai.com/v1/audio/transcriptions
SPEECH_MAX_SECONDS=60
SPEECH_MAX_BYTES=10485760
SPEECH_LIMIT_PER_MINUTE=6
SPEECH_TIMEOUT_SECONDS=30
