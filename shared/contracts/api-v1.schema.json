{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://revomail.local/contracts/api-v1.schema.json",
  "title": "RevoMail API v1 shared contracts",
  "$defs": {
    "error": {
      "type": "object",
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "required": ["code", "message", "retryable", "correlationId"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 },
            "retryable": { "type": "boolean" },
            "correlationId": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "required": ["nextCursor", "hasMore"],
      "properties": {
        "nextCursor": { "type": ["string", "null"] },
        "hasMore": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "oauthStart": {
      "type": "object",
      "required": ["authorizationUrl"],
      "properties": { "authorizationUrl": { "type": "string", "format": "uri" } },
      "additionalProperties": false
    },
    "aiOperation": {
      "type": "object",
      "required": ["messageIds", "operation"],
      "properties": {
        "messageIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "operation": { "enum": ["summary", "overview", "extract", "draft-reply"] }
      },
      "additionalProperties": false
    },
    "voiceCommand": {
      "type": "object",
      "required": ["transcript", "confirmed"],
      "properties": {
        "transcript": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "confirmed": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "taskMutation": {
      "type": "object",
      "required": ["title", "confirmed", "idempotencyKey"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "dueAt": { "type": ["string", "null"], "format": "date-time" },
        "confirmed": { "const": true },
        "idempotencyKey": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "calendarMutation": {
      "type": "object",
      "required": ["title", "startsAt", "timezone", "confirmed", "idempotencyKey"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "startsAt": { "type": "string", "format": "date-time" },
        "endsAt": { "type": ["string", "null"], "format": "date-time" },
        "timezone": { "type": "string", "minLength": 1 },
        "confirmed": { "const": true },
        "idempotencyKey": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
