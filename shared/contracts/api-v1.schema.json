{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://revomail.local/contracts/api-v1.schema.json",
  "title": "RevoMail API v1 shared contracts",
  "$defs": {
    "error": {
      "type": "object",
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "required": ["code", "message", "retryable", "correlationId"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 },
            "retryable": { "type": "boolean" },
            "correlationId": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "required": ["nextCursor", "hasMore"],
      "properties": {
        "nextCursor": { "type": ["string", "null"] },
        "hasMore": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "oauthStart": {
      "type": "object",
      "required": ["authorizationUrl"],
      "properties": { "authorizationUrl": { "type": "string", "format": "uri" } },
      "additionalProperties": false
    },
    "aiOperation": {
      "type": "object",
      "required": ["messageIds", "operation"],
      "properties": {
        "messageIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "operation": { "enum": ["summary", "overview", "extract", "draft-reply"] }
      },
      "additionalProperties": false
    },
    "voiceCommand": {
      "type": "object",
      "required": ["transcript", "confirmed"],
      "properties": {
        "transcript": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "confirmed": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "taskMutation": {
      "type": "object",
      "required": ["title", "confirmed", "idempotencyKey"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "dueAt": { "type": ["string", "null"], "format": "date-time" },
        "confirmed": { "const": true },
        "idempotencyKey": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "calendarMutation": {
      "type": "object",
      "required": ["title", "startsAt", "timezone", "confirmed", "idempotencyKey"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "startsAt": { "type": "string", "format": "date-time" },
        "endsAt": { "type": ["string", "null"], "format": "date-time" },
        "timezone": { "type": "string", "minLength": 1 },
        "confirmed": { "const": true },
        "idempotencyKey": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "mailboxMessage": {
      "type": "object",
      "required": ["id", "sender", "recipients", "subject", "receivedAt", "preview", "unread", "starred", "attachments"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "threadId": { "type": ["string", "null"] },
        "sender": { "type": "string" },
        "recipients": { "type": "array", "items": { "type": "string" } },
        "subject": { "type": "string" },
        "receivedAt": { "type": "string", "format": "date-time" },
        "preview": { "type": "string" },
        "unread": { "type": "boolean" },
        "starred": { "type": "boolean" },
        "category": { "type": ["string", "null"] },
        "attachments": { "type": "array", "items": { "type": "object" } },
        "bodyText": { "type": "string" },
        "bodyHtmlSafe": { "type": "string" }
      },
      "additionalProperties": false
    },
    "messageStateMutation": {
      "type": "object",
      "properties": { "unread": { "type": "boolean" }, "starred": { "type": "boolean" } },
      "minProperties": 1,
      "additionalProperties": false
    },
    "sendEmail": {
      "type": "object",
      "required": ["to", "subject", "bodyText", "confirmed", "idempotencyKey"],
      "properties": {
        "to": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "string" } },
        "cc": { "type": "array", "maxItems": 50, "items": { "type": "string" } },
        "bcc": { "type": "array", "maxItems": 50, "items": { "type": "string" } },
        "subject": { "type": "string", "minLength": 1, "maxLength": 998 },
        "bodyText": { "type": "string", "minLength": 1, "maxLength": 500000 },
        "inReplyToMessageId": { "type": ["string", "null"] },
        "confirmed": { "const": true },
        "idempotencyKey": { "type": "string", "minLength": 16, "maxLength": 200 }
      },
      "additionalProperties": false
    }
  }
}
