# RevoMail reads runtime configuration from the repository-root .env file.
# Copy ../.env.example to ../.env and keep real credentials untracked.

REVOMAIL_ENV=development
HOST=127.0.0.1
PORT=4173
APP_BASE_URL=http://localhost:4173
REVOMAIL_DEBUG=false
DATABASE_URL=file:./data/revomail.db
# SECRET_KEY and TOKEN_ENCRYPTION_KEY are optional; they are generated and
# stored in data/revomail-server.key on first startup when left empty.
SECRET_KEY=
TOKEN_ENCRYPTION_KEY=
JOB_LEASE_SECONDS=60
JOB_MAX_ATTEMPTS=3
MAIL_SEND_LIMIT_PER_MINUTE=10
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4173/api/v1/auth/google/callback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

AI_ALLOWED_MODELS=[]
SPEECH_MODEL=gpt-transcribe
SPEECH_API_URL=https://api.openai.com/v1/audio/transcriptions
SPEECH_MAX_SECONDS=60
SPEECH_MAX_BYTES=10485760
SPEECH_LIMIT_PER_MINUTE=6
SPEECH_TIMEOUT_SECONDS=30
TTS_MODEL=gpt-4o-mini-tts
TTS_API_URL=https://api.openai.com/v1/audio/speech
TTS_VOICE=alloy
TTS_MAX_CHARS=4096
TTS_LIMIT_PER_MINUTE=12
TTS_TIMEOUT_SECONDS=30
