# Copy this file to .env and fill in your values.
# Never commit .env to Git.

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
# get rid of the secret key when sharing this file
SECRET_KEY= #fill in the secret key

# CORS — space-separated list of allowed frontend origins
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:4173"]

# Google OAuth (from https://console.cloud.google.com → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# LLM provider — set whichever you use
OPENAI_API_KEY=

# Database (SQLite for local dev)
DATABASE_URL=sqlite:///./revomail.db
