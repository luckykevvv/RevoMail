# RevoMail reads runtime configuration from the repository-root .env file.
# Copy ../.env.example to ../.env and keep real credentials untracked.

HOST=0.0.0.0
PORT=4173
APP_BASE_URL=http://localhost:4173
REVOMAIL_DEBUG=false
SECRET_KEY=replace-with-a-random-session-signing-key
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4173/api/v1/auth/google/callback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
